# Umgebungsvariablen yannick-beck.de – Vorlage OHNE Werte (Beschreibung: docs/environment.md).
# Echte Werte nur in der Deploy-Umgebung (Coolify) bzw. lokal in .env.local – nie committen.

# Ghost Content API (Build + ISR). Ohne Werte baut die Seite mit leeren Ghost-Listen.
GHOST_URL=
GHOST_CONTENT_KEY=

# Ghost-Webhook → /api/revalidate?secret=…
REVALIDATE_SECRET=

# Vorschau-Builds: offene Angaben als gestrichelte „OFFEN: …“-Platzhalter, Vorschau-Hinweiszeile,
# Formular-Zustandsvorschau und Demo-Artikel. In Produktion leer lassen (nicht „0“ setzen).
NEXT_PUBLIC_SHOW_GAPS=

# Cloudflare Web Analytics (optional, cookiefrei)
NEXT_PUBLIC_CF_BEACON_TOKEN=
